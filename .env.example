# 진진거 environment variables
# Copy this file to `.env.local` for local development.
# Vercel: register the same keys via Project Settings → Environment Variables.
# See docs/architecture/data-model.md §12 for the full reference and
# docs/agent/SECRETS_POLICY.md for the secret handling policy.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (publicly safe). Used by both browser and server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (publicly safe). Used by the browser.
# Supabase's new key system replaces the legacy "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>

# Legacy compatibility: some older @supabase/* SDKs still expect the
# `NEXT_PUBLIC_SUPABASE_ANON_KEY` name. Set it to the same publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<placeholder>

# Service role key (SENSITIVE — server only, never ship to the browser).
# Used by Route Handlers / Edge Functions for cron, anonymized writes, audit reads, etc.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute base URL for redirects, OG tags, anonymized share links.
APP_BASE_URL=http://localhost:3000

# ── LLM provider ────────────────────────────────────────────────────────────
# Used by Route Handlers / Edge Functions only. Never expose to the browser.
LLM_API_KEY=<llm_provider_api_key>
LLM_MODEL=<provider/model-id>

# ── Family identity hash salt ──────────────────────────────────────────────
# Used to derive `public_post.author_family_hash` from family_id.
# DO NOT change after launch — rotating invalidates every existing public post hash.
FAMILY_HASH_SALT=<random-32+-char-string>
